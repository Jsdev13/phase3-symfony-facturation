<aside class="flex flex-col w-64 h-screen bg-white border-r border-gray-200">
    <div class="p-6 text-xl font-bold text-blue-700">FacturSaaS</div>

    <nav class="flex-1 px-4 space-y-1">
        {{ component('SidebarItem', { label: 'Dashboard', icon: '', route: 'app_dashboard' }) }}
        {{ component('SidebarItem', { label: 'Factures', icon: '', route: '#' }) }}
        {{ component('SidebarItem', { label: 'Clients', icon: '', route: '#' }) }}
        {{ component('SidebarItem', { label: 'Produits', icon: '', route: '#' }) }}
        {{ component('SidebarItem', { label: 'Profil', icon: '', route: 'app_profile' }) }}

    </nav>
    <div class="flex items-center gap-3 px-2 mb-3">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 text-xs flex items-center justify-center font-bold">
                    {{ app.user.firstName|default('J')|first|upper }}{{ app.user.lastName|default('D')|first|upper }}
            </div>
            <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold text-gray-800 truncate">{{ app.user.companyName|default('Tech Solutions') }}</p>
                    <p class="text-xs text-gray-400 truncate">{{ app.user.email|default('contact@entreprise.fr') }}</p>
            </div>
    </div>

    <div class="p-4 border-t border-gray-100">
        <a href="{{ path('app_logout') }}" class="text-red-500 text-sm font-medium">Déconnexion</a>
    </div>
