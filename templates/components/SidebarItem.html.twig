{% set currentRoute = app.request.attributes.get('_route') %}
{% set is_active = (currentRoute == route) or (active|default(false)) %}

<a href="{{ route == '#' ? '#' : path(route) }}" 
   class="flex items-center px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 {{ is_active ? 'bg-blue-50 text-blue-600' : 'text-gray-500 hover:bg-gray-50 hover:text-gray-700' }}">
    <span class="mr-3 text-lg">
        {% if icon == 'grid' %}  {% elseif icon == 'file' %}  {% elseif icon == 'users' %}  {% else %}  {% endif %}
    </span>
    {{ label }}
</a>
