{% extends 'base.html.twig' %}

{% block title %}Nouveau produit - FacturSaaS{% endblock %}

{% block body %}
<div class="p-10 bg-gray-50 min-h-screen">

    <div class="mb-8 max-w-5xl mx-auto">
        <a href="{{ path('produits_index') }}" class="text-sm text-gray-400 hover:text-gray-600 transition-colors flex items-center gap-1 mb-3 w-fit">
            <i class="fa-solid fa-arrow-left text-xs"></i>
            Retour à la liste
        </a>
        <h1 class="text-3xl font-bold text-gray-800 uppercase tracking-tight text-center">Ajouter un nouveau produit</h1>
    </div>

    <div class="bg-white border border-gray-200 shadow-sm rounded-2xl max-w-xl mx-auto p-8 mb-16 relative">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-lg font-bold text-gray-800">Nouveau produit</h2>
            <button type="button" class="text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
        </div>

        {{ form_start(form, { attr: { class: 'space-y-5', novalidate: 'novalidate' } }) }}
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Nom</label>
                {{ form_widget(form.name, {
                    attr: {
                        class: 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-400',
                        placeholder: 'Ex : Vitrine enrichissement'
                    }
                }) }}
                {{ form_errors(form.name, { attr: { class: 'text-xs text-red-500 mt-1' } }) }}
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                {{ form_widget(form.description, {
                    attr: {
                        class: 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-400',
                        placeholder: 'argent gratuit ',
                        rows: 3
                    }
                }) }}
                {{ form_errors(form.description, { attr: { class: 'text-xs text-red-500 mt-1' } }) }}
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Prix</label>
                    <div class="relative">
                        {{ form_widget(form.price, {
                            attr: {
                                class: 'w-full border border-gray-300 rounded-lg pl-3 pr-8 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent',
                                placeholder: '0'
                            }
                        }) }}
                        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">€</span>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Unité</label>
                    {{ form_widget(form.unit, {
                        attr: {
                            class: 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white'
                        }
                    }) }}
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4">
                <a href="{{ path('produits_index') }}" class="px-6 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                    Annuler
                </a>
                <button type="submit" class="px-6 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-md transition-all font-medium flex items-center gap-2">
                    <i class="fa-regular fa-floppy-disk"></i>
                    Enregistrer
                </button>
            </div>
        {{ form_end(form) }}
    </div>

    <div class="max-w-5xl mx-auto">
        <h2 class="text-xl font-bold text-center mb-8 text-gray-700">Produits & Services existant</h2>
        
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden text-gray-800">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-gray-50/80 border-b border-gray-200">
                        <th class="px-6 py-4 text-xs font-bold uppercase text-gray-500">Nom</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase text-gray-500">Description</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase text-gray-500">Prix unitaire</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase text-gray-500 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for product in products %}
                        <tr class="hover:bg-gray-50/50 transition-colors">
                            <td class="px-6 py-5 text-sm font-medium text-gray-900">{{ product.name }}</td>
                            <td class="px-6 py-5 text-sm text-gray-500">{{ product.description }}</td>
                            <td class="px-6 py-5 text-sm font-semibold">
                             {{ product.price }} € / {{ product.unit.value }}
                            </td>
                            <td class="px-6 py-5 text-right">
                                <div class="flex justify-end gap-3">
                                    <a href="{{ path('produits_edit', {id: product.id}) }}" class="p-2 text-blue-500 hover:bg-blue-50 rounded-lg transition-colors">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    
                                    <form method="post" action="{{ path('produits_delete', {id: product.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');" class="inline-block">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                        <button class="p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-gray-400 italic bg-gray-50/30">
                                Aucun produit dans votre catalogue.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}